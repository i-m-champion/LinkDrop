{
  "name": "insta-reel-turbo",
  "version": "1.0.0",
  "description": "High-speed batch Instagram Reel downloader with parallel extraction, live SSE progress, instant video preview, and wire-speed ZIP streaming.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "instagram",
    "reels",
    "downloader",
    "batch-downloader",
    "video-downloader",
    "high-speed",
    "zip-streaming",
    "react",
    "express"
  ],
  "license": "MIT",
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "gsap": "^3.15.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
